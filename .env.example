# Senha do painel (usuário: qualquer; senha: esta). Obrigatória em produção.
DASHBOARD_PASSWORD=troque-esta-senha

# Token que a rotina do Claude usa para enviar dados (POST /api/ingest)
INGEST_TOKEN=gere-um-token-longo-aleatorio

# Token para conectar o painel ao Claude como servidor MCP (/api/mcp)
MCP_TOKEN=gere-outro-token-longo-aleatorio

# Chat e análises com Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Banco (Upstash Redis via Vercel Marketplace). Sem isso, usa os dados de exemplo em memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
